---
interface Props {
	paintings: string[];
	randomHref: string;
}

const { paintings, randomHref } = Astro.props;

const items = [
	{ href: '/works/systems', label: 'Tour the museum', angle: '-18deg' },
	{ href: '/resume.pdf', label: 'Résumé', angle: '-36deg' },
	{ href: 'https://github.com/kha-adam', label: 'GitHub', angle: '-54deg' },
	{ href: '/contact', label: 'Contact', angle: '-72deg' },
	{ href: randomHref, label: 'Random painting', angle: '-90deg', random: true },
];
---

<details class="apple" data-apple>
	<summary aria-label="Museum menu">
		<svg viewBox="0 0 64 64" aria-hidden="true">
			<defs>
				<symbol id="bite-0" viewBox="0 0 64 64">
					<path fill="var(--gold)" d="M33 17c1.2-4.2 4-6.4 7.2-7.2-.2 1.2-.6 2.2-1.2 3.1" />
					<path fill="var(--apple)" d="M34 16c2.4-5.2 8.6-7.4 12.4-6.2-1.4 5.2-6.2 8.6-11.2 8.8-1 .1-1.6-.6-1.2-2.6z" />
					<path fill="var(--apple)" d="M32 18c-9.2 0-16 7.2-17.2 16.4C13.4 46 19.2 58 32 58s18.6-12 17.2-23.6C47.8 25.2 41.2 18 32 18z" />
				</symbol>
				<symbol id="bite-1" viewBox="0 0 64 64">
					<path fill="var(--gold)" d="M33 17c1.2-4.2 4-6.4 7.2-7.2-.2 1.2-.6 2.2-1.2 3.1" />
					<path fill="var(--apple)" d="M34 16c2.4-5.2 8.6-7.4 12.4-6.2-1.4 5.2-6.2 8.6-11.2 8.8-1 .1-1.6-.6-1.2-2.6z" />
					<path
						fill="var(--apple)"
						fill-rule="evenodd"
						d="M32 18c-9.2 0-16 7.2-17.2 16.4C13.4 46 19.2 58 32 58s18.6-12 17.2-23.6C47.8 25.2 41.2 18 32 18zM54 28a6 6 0 1 1-12 0 6 6 0 0 1 12 0z"
					/>
				</symbol>
				<symbol id="bite-2" viewBox="0 0 64 64">
					<path fill="var(--gold)" d="M33 17c1.2-4.2 4-6.4 7.2-7.2-.2 1.2-.6 2.2-1.2 3.1" />
					<path fill="var(--apple)" d="M34 16c2.4-5.2 8.6-7.4 12.4-6.2-1.4 5.2-6.2 8.6-11.2 8.8-1 .1-1.6-.6-1.2-2.6z" />
					<path
						fill="var(--apple)"
						fill-rule="evenodd"
						d="M32 18c-9.2 0-16 7.2-17.2 16.4C13.4 46 19.2 58 32 58s18.6-12 17.2-23.6C47.8 25.2 41.2 18 32 18zM61 31a11 11 0 1 1-22 0 11 11 0 0 1 22 0z"
					/>
				</symbol>
				<symbol id="bite-3" viewBox="0 0 64 64">
					<path fill="var(--gold)" d="M33 17c1.2-4.2 4-6.4 7.2-7.2-.2 1.2-.6 2.2-1.2 3.1" />
					<path
						fill="var(--apple)"
						fill-rule="evenodd"
						d="M32 18c-9.2 0-16 7.2-17.2 16.4C13.4 46 19.2 58 32 58s18.6-12 17.2-23.6C47.8 25.2 41.2 18 32 18zM68 34a16 16 0 1 1-32 0 16 16 0 0 1 32 0z"
					/>
				</symbol>
				<symbol id="bite-4" viewBox="0 0 64 64">
					<path
						fill="var(--apple)"
						fill-rule="evenodd"
						d="M32 18c-9.2 0-16 7.2-17.2 16.4C13.4 46 19.2 58 32 58s18.6-12 17.2-23.6C47.8 25.2 41.2 18 32 18zM78 36a22 22 0 1 1-44 0 22 22 0 0 1 44 0z"
					/>
				</symbol>
				<symbol id="bite-5" viewBox="0 0 64 64">
					<ellipse cx="32" cy="38" rx="8" ry="11" fill="var(--apple)" />
					<ellipse cx="29.2" cy="35" rx="1.5" ry="2.6" fill="var(--gold)" />
					<ellipse cx="34.6" cy="41" rx="1.5" ry="2.6" fill="var(--gold)" />
				</symbol>
			</defs>
			<use href="#bite-0" data-apple-use></use>
		</svg>
	</summary>
	<nav aria-label="Apple" data-paintings={JSON.stringify(paintings)}>
		{
			items.map((item) => (
				<a href={item.href} style={`--angle: ${item.angle}`} data-random={item.random ? '' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
</details>

<script>
	import { bindApple } from '../scripts/apple';

	const root = document.querySelector('[data-apple]');
	if (root) bindApple(root);
</script>
