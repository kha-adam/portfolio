---
import { getCollection } from 'astro:content';
import PaintingCard from '../components/PaintingCard.astro';
import Base from '../layouts/Base.astro';
import { sortPaintings } from '../lib/paintings';

const hanging = sortPaintings(await getCollection('paintings')).filter((painting) => painting.data.featured);

const swatches = [
	{ name: '--bg', hex: '#0b0908', className: 'chip-bg' },
	{ name: '--surface', hex: '#15110f', className: 'chip-surface' },
	{ name: '--text', hex: '#e8dcc0', className: 'chip-text' },
	{ name: '--gold', hex: '#d9c9a3', className: 'chip-gold' },
	{ name: '--apple', hex: '#c8102e', className: 'chip-apple' },
];
---

<Base title="Knowledge, compiled." description="Knowledge, compiled. A museum of Adam Khalloufi's work.">
	<p class="kicker">Entrance hall</p>
	<h1>Knowledge, compiled.</h1>
	<p class="lede">Two paintings are hung. The other rooms are still empty.</p>
	<section class="hanging" aria-labelledby="hanging-title">
		<h2 id="hanging-title" class="kicker">Now hanging</h2>
		<ul class="gallery">
			{hanging.map((painting) => (
				<li>
					<PaintingCard painting={painting} />
				</li>
			))}
		</ul>
	</section>
	<ul class="swatches">
		{
			swatches.map((swatch) => (
				<li>
					<span class:list={['chip', swatch.className]}></span>
					<p class="token">{swatch.name}</p>
					<p class="hex">{swatch.hex}</p>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.chip-bg {
		background: var(--bg);
	}
	.chip-surface {
		background: var(--surface);
	}
	.chip-text {
		background: var(--text);
	}
	.chip-gold {
		background: var(--gold);
	}
	.chip-apple {
		background: var(--apple);
	}
</style>
